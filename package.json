{
  "name": "@hona/ocdx",
  "version": "0.1.0",
  "description": "Build extensions for OpenCode Desktop",
  "keywords": [
    "opencode",
    "desktop",
    "electron",
    "extensions",
    "modding"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hona/opencode-desktop-extensions.git"
  },
  "homepage": "https://github.com/Hona/opencode-desktop-extensions#readme",
  "bugs": {
    "url": "https://github.com/Hona/opencode-desktop-extensions/issues"
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/main.d.ts",
    "dist/main.js",
    "dist/solid.d.ts",
    "dist/solid.js",
    "dist/types.d.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run script/build.ts && tsc -p tsconfig.build.json",
    "build:all": "bun run build && cargo build --manifest-path launcher/Cargo.toml --release --locked && bun run script/package.ts",
    "launch": "bun run script/launch.ts",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/channel.test.cjs && playwright test"
  },
  "peerDependencies": {
    "@opencode-ai/client": "*",
    "@opencode-ai/ui": "*",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/client": "^0.0.0-beta-19271",
    "@opencode-ai/ui": "^0.0.0-beta-19271",
    "@playwright/test": "^1.63.0",
    "@solidjs/meta": "0.29.4",
    "@types/bun": "1.3.13",
    "@zip.js/zip.js": "2.7.62",
    "electron": "42.3.3",
    "solid-js": "1.9.10",
    "typescript": "5.8.2",
    "vite": "7.1.4",
    "vite-plugin-solid": "2.11.10"
  }
}
